{
  "installCommand": "npm install && gem install bundler && rm -f Gemfile.lock && bundle install",
  "buildCommand": "bundle exec jekyll build",
  "outputDirectory": "_site",
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/checkout.js": {
      "includeFiles": "db/checkout-schema.sql",
      "maxDuration": 10
    }
  }
}
